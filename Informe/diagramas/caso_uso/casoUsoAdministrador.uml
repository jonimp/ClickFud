@startuml
left to right direction

actor Administrador

rectangle "Sistema de Pedidos Restaurante" {

    usecase "Recibir pedidos" as UC1
    usecase "Procesar pedido" as UC2
    usecase "Confirmar pedido" as UC3
    usecase "Delegar entrega a repartidor" as UC4
  
}

Administrador --> UC1
Administrador --> UC2
Administrador --> UC3
Administrador --> UC4




@enduml
